;;; Checks that the SIMD color conversion matches the scalar formula exactly
(load (merge-pathnames "load.lisp" (directory-namestring *load-truename*)))
(format t "NEON enabled: ~a~%" (and (member :cl-jpeg-neon *features*) t))
(defun term (c1 k1 &optional (c2 0) (k2 0)) (ash (+ (* c1 k1) (* c2 k2) 32768) -16))
(defun clamp (v) (max 0 (min 255 v)))
(let ((bad 0) (n 0))
  (dolist (f (directory (merge-pathnames "check/base_*.jpg" (directory-namestring *load-truename*))))
    (multiple-value-bind (raw h w nc) (jpeg:decode-image f :colorspace-conversion nil)
      (when (= nc 3)
        (incf n)
        (let ((bgr (jpeg:decode-image f)))
          (dotimes (i (* h w))
            (let* ((p (* 3 i)) (y (aref raw p)) (cb (- (aref raw (+ p 1)) 128)) (cr (- (aref raw (+ p 2)) 128)))
              (unless (and (= (aref bgr p) (clamp (+ y (term cb 116130))))
                           (= (aref bgr (+ p 1)) (clamp (+ y (term cb -22554 cr -46802))))
                           (= (aref bgr (+ p 2)) (clamp (+ y (term cr 91881)))))
                (incf bad)
                (when (< bad 5) (format t "mismatch ~a pixel ~d~%" (file-namestring f) i)))))))))
  (format t "~d color images, ~d mismatching pixels~%" n bad))
