;;; Checks that the NEON IDCT matches the scalar one on random blocks
(load (merge-pathnames "load.lisp" (directory-namestring *load-truename*)))
(in-package :jpeg)
(let ((bad 0) (n 200000)
      (block (make-array 64 :element-type '(signed-byte 32)))
      (ws (make-array 64 :element-type 'fixnum))
      (p1 (make-array (* 64 4) :element-type 'uint8))
      (p2 (make-array (* 64 4) :element-type 'uint8)))
  (dotimes (i n)
    (fill block 0)
    ;; sparse low-frequency blocks mostly, some dense, values up to +-2047
    (let ((k (if (< (random 10) 8) (1+ (random 6)) 64)))
      (dotimes (j k)
        (setf (aref block (if (= k 64) j (random (min 64 (* 4 k))))) (- (random 4095) 2047))))
    (idct-block-scalar block ws p1 8 32)
    (idct-block block ws p2 8 32)
    (unless (equalp p1 p2)
      (incf bad)
      (when (< bad 3) (format t "mismatch: ~a~% scalar ~a~% neon   ~a~%" block (subseq p1 8 16) (subseq p2 8 16)))))
  (format t "~d random blocks, ~d mismatches~%" n bad))
