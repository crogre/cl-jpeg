;;; Median decode time and allocation at each scale, from memory
(load (merge-pathnames "load.lisp" (directory-namestring *load-truename*)))
(defun decode-mem-scaled (bytes scale)
  (let ((d (jpeg:make-descriptor)))
    (setf (jpeg:descriptor-source-cache d) bytes)
    (jpeg:decode-stream nil :cached-source-p t :descriptor d :scale scale)))
(format t "~26a ~{~14a~}~%" "image" '("1" "1/2" "1/4" "1/8"))
(dolist (f (script-args))
  (let ((bytes (file-bytes f)))
    (format t "~26a" (file-namestring f))
    (dolist (scale '(1 1/2 1/4 1/8))
      (decode-mem-scaled bytes scale)
      (let* ((times (loop repeat 9 collect
                      (let ((t0 (get-internal-real-time)))
                        (decode-mem-scaled bytes scale)
                        (/ (- (get-internal-real-time) t0) 1000.0))))
             (b0 (sb-ext:get-bytes-consed)))
        (decode-mem-scaled bytes scale)
        (format t " ~5,1fms ~5,1fMB" (nth 4 (sort times #'<)) (/ (- (sb-ext:get-bytes-consed) b0) 1e6))))
    (terpri)))
