;;; Decodes every image in check/list.txt and compares it with djpeg's output.
;;; Fails if any pixel differs by more than 6 levels (the IDCTs differ slightly).
(load (merge-pathnames "load.lisp" (directory-namestring *load-truename*)))
(defun read-pnm (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (labels ((tok () (let ((c (read-byte s)))
                       (loop while (member c '(32 10 13 9)) do (setf c (read-byte s)))
                       (coerce (loop while (not (member c '(32 10 13 9))) collect (code-char c)
                                     do (setf c (read-byte s))) 'string))))
      (let* ((magic (tok)) (w (parse-integer (tok))) (h (parse-integer (tok))) (nc (progn (tok) (if (string= magic "P6") 3 1)))
             (d (make-array (* w h nc) :element-type '(unsigned-byte 8))))
        (read-sequence d s) (values d w h nc)))))
(let* ((dir (merge-pathnames "check/" (directory-namestring *load-truename*)))
       (names (with-open-file (l (merge-pathnames "list.txt" dir)) (loop for x = (read-line l nil) while x collect x)))
       (failed '()))
  (dolist (name names)
    (handler-case
        (multiple-value-bind (buf h w nc) (jpeg:decode-image (merge-pathnames (concatenate 'string name ".jpg") dir))
          (multiple-value-bind (ref rw rh rnc) (read-pnm (merge-pathnames (concatenate 'string name ".ref") dir))
            (assert (and (= w rw) (= h rh) (= nc rnc)))
            (let ((mx 0))
              (dotimes (i (length ref))
                ;; cl-jpeg returns BGR, djpeg RGB
                (let ((j (if (= nc 3) (+ (* 3 (floor i 3)) (- 2 (mod i 3))) i)))
                  (setf mx (max mx (abs (- (aref buf j) (aref ref i)))))))
              (when (> mx 6) (push name failed) (format t "~a: max diff ~d~%" name mx)))))
      (error (e) (push name failed) (format t "~a: ERROR ~a~%" name e))))
  (format t "~d/~d images OK~@[, FAILED: ~{~a~^ ~}~]~%" (- (length names) (length failed)) (length names) failed)
  (sb-ext:exit :code (if failed 1 0)))
