;;; Times idct-block on a sparse block (DC + a few low AC) and a dense one
(load (merge-pathnames "load.lisp" (directory-namestring *load-truename*)))
(in-package :jpeg)
(defun run-idct (block n)
  (declare #.*optimize* (type fixnum n))
  (let ((ws (make-array 64 :element-type 'fixnum))
        (plane (make-array (* 64 8) :element-type 'uint8)))
    (dotimes (i n) (idct-block block ws plane 0 64))
    plane))
(dolist (spec '((:sparse . ((0 . 400) (1 . 30) (8 . -20) (9 . 5)))
                (:dense . nil)))
  (let ((block (make-array 64 :element-type '(signed-byte 32) :initial-element 0)))
    (if (cdr spec)
        (loop for (i . v) in (cdr spec) do (setf (aref block i) v))
        (dotimes (i 64) (setf (aref block i) (- (random 200) 100))))
    (run-idct block 1000)
    (let ((t0 (get-internal-real-time)) (n 2000000))
      (run-idct block n)
      (format t "~a: ~,1f ns/block~%" (car spec) (/ (* 1000.0 (- (get-internal-real-time) t0)) n)))))
